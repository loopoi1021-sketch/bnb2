# 이 파일을 .env 로 복사한 뒤 값을 채우세요: cp .env.example .env
# .env 는 git 에 올라가지 않습니다.

# Claude (console.anthropic.com) - 4단계부터 필요
ANTHROPIC_API_KEY=

# Voyage 임베딩 (dashboard.voyageai.com) - 2단계부터 필요
VOYAGE_API_KEY=

# 검색용 pgvector DB - 1단계에서 Docker 로 띄움
DATABASE_URL=postgresql://bnb2:bnb2@localhost:5433/bnb2

# Langfuse Cloud (jp.cloud.langfuse.com 에서 가입 → 프로젝트 → Settings → API Keys) - 5단계부터 필요
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Langfuse 로 보낼 때 가릴 글자 (쉼표로 구분). 전화번호·이메일은 자동으로 가려진다.
# 예: 주소, 와이파이 비밀번호, 현관 비밀번호
MASK_TERMS=

# 슬랙 앱 (7단계에서 발급): xoxb-... (Bot Token), xapp-... (App-Level Token)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# 담당자 판단·문서에 없음일 때 멘션할 사람의 슬랙 멤버 ID (예: U0123ABCD). 비워두면 멘션 안 함
SLACK_OWNER_ID=
